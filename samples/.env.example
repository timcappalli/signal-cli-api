# Base URL of the signal-cli-api service
SIGNAL_API_URL=http://localhost:8080

# Scoped client API key (with "send" and "receive" permissions) generated in /admin
SIGNAL_API_KEY=sig_your_scoped_client_key_here

# Optional when the API key is scoped to a single account or only 1 account is registered
# SIGNAL_ACCOUNT=+15550001111
