# Port to expose on host
PORT=8080

# Root Administration Key for Managing Client API Keys (REQUIRED, min 16 chars)
# Generate a strong key with: openssl rand -hex 32
# Access the Admin UI at: http://localhost:8080/admin
API_KEY_MGMT=

# Optional comma-separated Host header and Origin allowlists (defaults to localhost, 127.0.0.1, ::1)
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# Optional Reverse Proxy Client IP Header (e.g. X-Forwarded-For or X-Real-IP) and Trusted Proxy CIDRs
# Default trusts NO proxy IPs; set TRUSTED_PROXIES explicitly (e.g. 127.0.0.1/32,172.18.0.1/32) when behind a reverse proxy
TRUSTED_PROXY_HEADER=
TRUSTED_PROXIES=
